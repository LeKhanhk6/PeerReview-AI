# Server Config
PORT=5000

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.xxx:xxx@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# AI Service Config
AI_PROVIDER=gemini
GEMINI_API_KEY="your_api_key_here"
AI_API_URL="https://generativelanguage.googleapis.com/v1beta"
AI_TIMEOUT=5000

# Authentication
JWT_SECRET="your_secret_key"
JWT_EXPIRES_IN="24h"

# Enable destructive actions that require audit logging
AUDIT_ENABLED=false
